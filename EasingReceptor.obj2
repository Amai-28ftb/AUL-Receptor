--[[
    Script の動作にイージングを適用させる為の Script です
    直接 .tra2 の計算式を取得できない為、苦肉の策でこうなりました
    オブジェクトの 0～totaltime の範囲で分割サンプリングをし、疑似的にイージングを再現。グローバル変数として公開。
    チェックボックスをONにするとサンプリングしたカーブを簡易的に描画します
]]
--track@get_easing:軌道適応用,0,100,0,1
--track@easing_id:軌道番号,1,100,1,1
--check@show_graph:波形表示,1
--check@text_pos:文字位置,0
--value@sample_div:サンプル数,100


-- 設定値
local config = {
    -- 設定値まとめ
    easing_id = easing_id,  -- 軌道番号
    sample_div = math.max(1, math.floor(sample_div or 1)),  -- サンプル数（下げると精度が下がり、上げると重くなります）
    canvas_size = 300, -- 描画キャンバスのサイズ

    show_graph = show_graph,    -- 波形の表示
    text_pos = text_pos,        -- テキスト位置を左上から右下に

    bg_colour = 0x191919,       -- 波形色
    line_colour = 0x02edaf,     -- グラフの色
    frame_colour = 0xffffff,    -- 枠の色

    text_font = "MS UI Gothic", -- 軌道番号のフォント
    text_size = 40,             -- 軌道番号のサイズ
    text_colour = 0x02edaf      -- 軌道番号の色
}

-- グローバル変数
if _G.easing_curves_28 == nil then
    _G.easing_curves_28 = {}
end

-- セクションのやつ
local section_num = obj.getoption("section_num")
local section_times = {}
for i = 0, section_num - 1 do
    section_times[i] = obj.getvalue("time", 0, i)
end
section_times[section_num] = obj.getvalue("time", 0, -1)

-- セクション番号を返す
local function find_section(t)
    for s = 0, section_num - 1 do
        if t <= section_times[s + 1] then
            return s
        end
    end
    return section_num - 1
end

-- 0～totaltime を sample_div 分割し、各点のイージング値をサンプリング
local function sample_curve(sample_div)
    local samples = {}
    for i = 0, sample_div do
        local t = (i / sample_div) * obj.totaltime
        local section = find_section(t)
        local value = obj.getvalue("track.get_easing", t, section)
        samples[i + 1] = (value or 0) / 100
    end
    return samples
end

local samples = sample_curve(config.sample_div)

_G.easing_curves_28[config.easing_id] = {
    samples = samples,
    div     = config.sample_div,
}


if _G.easing_eval_28 == nil then
    -- 戻り値:イージング適用後の値。該当idが未公開ならxをそのまま返します。
    _G.easing_eval_28 = function(id, x)
        x = math.max(0, math.min(1, x))
        local curve = _G.easing_curves_28 and _G.easing_curves_28[id]
        if curve == nil then
            return x
        end

        local pos = x * curve.div
        local index = math.floor(pos)
        local next_index = math.min(index + 1, curve.div)
        local fraction = pos - index

        return curve.samples[index + 1] * (1 - fraction) + curve.samples[next_index + 1] * fraction
    end
end


-- グラフ描画用
if show_graph == 1 then
    local half_size = config.canvas_size * 0.5
    local function draw_line(x0, y0, x1, y1, width, color, alpha)
        local dx, dy = x1 - x0, y1 - y0
        local len = (dx * dx + dy * dy) ^ 0.5
        if len == 0 then return end
        local hw = width / 2
        local nx, ny = -dy / len * hw, dx / len * hw
        obj.load("figure", "四角形", color)
        obj.drawpoly(
            x0 + nx, y0 + ny, 0,
            x1 + nx, y1 + ny, 0,
            x1 - nx, y1 - ny, 0,
            x0 - nx, y0 - ny, 0
        )
    end


    -- グラフによってはこれでもはみ出るらしいので、お好きに調整してください
    obj.setoption("drawtarget", "tempbuffer", config.canvas_size * 1.8, config.canvas_size * 1.8)

    -- 背景
    obj.load("figure", "四角形", config.bg_colour, config.canvas_size)
    obj.draw(0, 0)

    -- カーブ
    obj.load("figure", "円", config.line_colour)
    for i = 1, config.sample_div do
        local x0 = (i - 1) / config.sample_div * config.canvas_size - half_size
        local y0 = -(samples[i] * config.canvas_size - half_size)
        local x1 = i / config.sample_div * config.canvas_size - half_size
        local y1 = -(samples[i + 1] * config.canvas_size - half_size)
        draw_line(x0, y0, x1, y1, 3, 0x02edaf)
    end

    -- 枠
    obj.load("figure", "四角形", config.frame_colour, config.canvas_size + 2, 3)
    obj.draw(0, 0)

    -- イージング番号ラベル
    obj.setfont(config.text_font, config.text_size, 0, config.text_colour)
    obj.load(config.easing_id)
    if config.text_pos == 1 then
        obj.draw(half_size - 25, half_size - 25)
    else
        obj.draw(-half_size + 25, -half_size + 25)
    end

    obj.load("tempbuffer")
end
